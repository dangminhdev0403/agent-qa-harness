{
  "$schema": "./node_modules/agent-qa-harness/schema/harness.schema.json",
  "project": "my-application",
  "baseUrl": "http://localhost:3000",
  "timeoutMs": 30000,
  "outputDir": "harness-out",

  "preflight": {
    "enabled": true,
    "retries": 3,
    "delayMs": 1000,
    "healthEndpoint": "/api/health"
  },

  "authProvider": {
    "enabled": false,
    "endpoint": "/api/v1/auth/login",
    "method": "POST",
    "credentials": {
      "email": "test-admin@example.com",
      "password": "secretPassword123"
    },
    "tokenPath": "data.accessToken"
  },

  "static": {
    "enabled": true,
    "commands": [
      {
        "name": "UI Verification Rules",
        "cmd": "node scripts/verify-ui-rules.cjs"
      },
      {
        "name": "Contract & Schema Check",
        "cmd": "npm run test:contracts"
      }
    ]
  },

  "realtime": {
    "enabled": true,
    "provider": "socket.io",
    "scenarios": [
      {
        "name": "order-notification-roundtrip",
        "description": "Verifies that when an order is created, the staff socket receives ORDER_CREATED event",
        "receiver": {
          "endpoint": "/staff-ops",
          "listenEvent": "ORDER_CREATED",
          "assertPayload": {
            "status": "PENDING"
          }
        },
        "trigger": {
          "type": "http",
          "method": "POST",
          "path": "/api/v1/orders",
          "body": {
            "orderNumber": "ORD-{{timestamp}}",
            "customerId": "cust-{{shortId}}",
            "items": [{ "sku": "ITEM-1", "quantity": 2 }]
          }
        },
        "timeoutMs": 4000
      }
    ]
  },

  "concurrency": {
    "enabled": true,
    "scenarios": [
      {
        "name": "anti-double-approval-gate",
        "description": "Fires 5 simultaneous approvals with dynamic order ID - exactly 1 must succeed",
        "method": "POST",
        "path": "/api/v1/orders/ORD-{{timestamp}}/approve",
        "concurrentBurst": 5,
        "injectRequestId": true,
        "assert": {
          "expected200": 1,
          "expectedConflictOrBad": 4
        }
      }
    ]
  },

  "browser": {
    "enabled": true,
    "zeroConsoleErrors": true,
    "zeroNetworkErrors": true,
    "captureScreenshots": true,
    "routes": [
      {
        "path": "/dashboard",
        "waitForSelector": "[data-testid='metrics-grid']"
      }
    ],
    "flows": [
      {
        "name": "luong-tao-khach-hang-moi",
        "steps": [
          { "action": "navigate", "url": "/customers/new" },
          { "action": "fill", "selector": "input[name='email']", "value": "guest-{{timestamp}}@test.com" },
          { "action": "waitFor", "durationMs": 300 },
          { "action": "assertNoErrors" }
        ]
      }
    ]
  }
}
